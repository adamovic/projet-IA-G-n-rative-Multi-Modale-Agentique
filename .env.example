# MaintiDoc Environment Configuration

# PostgreSQL & PGVector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=maintdoc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ollama LLM Configuration (Local CPU friendly)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=120

# Embedding Models
TEXT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TEXT_EMBEDDING_DIM=384
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai
CLIP_EMBEDDING_DIM=512

# Processing & Hardware Settings
DEVICE=cpu
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5

# Directories
DATA_DIR=data
DOCUMENTS_DIR=data/documents
EXTRACTED_TEXT_DIR=data/extracted_text
EXTRACTED_IMAGES_DIR=data/extracted_images
EXTRACTED_TABLES_DIR=data/extracted_tables
